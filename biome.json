{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "files": {
    "includes": [
      "backend/src/**",
      "backend/test/**",
      "frontend/app/**",
      "frontend/components/**",
      "frontend/lib/**",
      "frontend/test/**",
      "e2e/tests/**",
      "e2e/playwright.config.ts",
      "scripts/**",
      "e2e/*.mjs"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "off",
        "noArrayIndexKey": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off"
      },
      "complexity": {
        "noForEach": "off",
        "noImportantStyles": "off"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "off",
        "useExhaustiveDependencies": "warn"
      },
      "a11y": {
        "recommended": true
      },
      "performance": {
        "noImgElement": "off"
      }
    }
  }
}