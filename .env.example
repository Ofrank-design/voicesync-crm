# ---------- Backend (backend/.env) ----------
# ---- AI providers ----
# Pick one provider per step. Only the keys of the providers you pick are required.
# Transcription (audio to text): openai or groq.
TRANSCRIPTION_PROVIDER=openai
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Required when TRANSCRIPTION_PROVIDER is not openai. Use a speech model that provider serves.
TRANSCRIPTION_MODEL=
# Optional: your own speech endpoint. Must be a full http or https URL.
TRANSCRIPTION_BASE_URL=
# Extraction (text to a task): anthropic, openai, gemini, groq, openrouter, nvidia or huggingface.
EXTRACTION_PROVIDER=anthropic
# Model ID. For anthropic you can use ANTHROPIC_MODEL instead. There is no default on purpose:
# set a model your provider currently serves, and check it supports JSON style answers.
EXTRACTION_MODEL=
ANTHROPIC_MODEL=
# Optional: your own endpoint (for example a self hosted NVIDIA NIM). Must be a full http or https URL.
EXTRACTION_BASE_URL=
# Optional: ask the provider for JSON mode. Support varies by provider and model, so it is off by default.
EXTRACTION_JSON_MODE=false
# Comma separated Supabase user IDs who may open Provider settings (in AUTH_MODE=local the dev user always can).
ADMIN_USER_IDS=
# ---- Reliability and limits (all optional) ----
# A backup provider is used ONLY when the main one is down, overloaded or out of credit. The person is told when it happens.
# It must be a different provider from the main one, with its own key and model.
FALLBACK_EXTRACTION_PROVIDER=
FALLBACK_EXTRACTION_MODEL=
FALLBACK_TRANSCRIPTION_PROVIDER=
FALLBACK_TRANSCRIPTION_MODEL=
# After this many provider failures in a row, pause that provider for the cooldown, then test it with one call.
BREAKER_FAILURES=5
BREAKER_COOLDOWN_SECONDS=30
# How many voice notes are processed at once, and how long an extra note waits before getting a "busy" message.
AI_MAX_CONCURRENCY=4
AI_QUEUE_TIMEOUT_MS=15000
# Daily allowance per person (resets at midnight UTC). Leave empty for no limit. A note counts when a task draft is returned.
USER_DAILY_NOTES=
USER_DAILY_AUDIO_MINUTES=

# ---- Operations (all optional) ----
# One JSON line per event on stdout: debug, info, warn, error or silent.
LOG_LEVEL=info
# How many reverse proxies sit in front of the API. Wrong values make rate limits count the proxy instead of each person.
TRUST_PROXY=1
# 24+ characters turns on GET /metrics (Prometheus). Leave empty to keep it off.
METRICS_TOKEN=
# Seconds a confirmed sign in is trusted before Supabase is asked again (0 = always ask).
AUTH_CACHE_SECONDS=30
# Seconds to let requests finish when the server is told to stop.
SHUTDOWN_TIMEOUT_SECONDS=25

# Keys (server side only, never in the frontend)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
HUGGINGFACE_API_KEY=
# HF_TOKEN also works for Hugging Face
HF_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
APP_TIMEZONE=UTC
MAX_AUDIO_SIZE_MB=20
MAX_RECORDING_SECONDS=300
# Recordings are never stored. Setting this to true makes the server refuse to start.
AUDIO_RETENTION_ENABLED=false
# Save the transcript alongside each task (privacy: off by default)
STORE_TRANSCRIPTS=false
# supabase = verify Supabase JWTs. local = single fixed dev user, refused when NODE_ENV=production.
AUTH_MODE=supabase
LOCAL_DEV_USER_ID=00000000-0000-0000-0000-000000000001
NODE_ENV=development

# ---------- Frontend (frontend/.env.local) ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_AUTH_MODE=supabase
# Your real public web address (used for share links, robots.txt, sitemap and security headers).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: shown on the privacy page.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_MAX_RECORDING_SECONDS=300
NEXT_PUBLIC_MAX_AUDIO_SIZE_MB=20
